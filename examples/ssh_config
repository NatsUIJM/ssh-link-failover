# ~/.ssh/config 片段：一个别名自动选路
#
# HostName 固定写最优链路的 IP 是刻意的：ProxyCommand 决定实际连哪个 IP，
# 而 known_hosts 按 HostName 记录主机密钥。几条链路连的是同一台机器、同一把 host key，
# 固定 HostName 后切换链路不会出现 host key 告警。
Host myhost
  HostName 192.168.10.2
  User me
  IdentityFile ~/.ssh/id_ed25519
  ServerAliveInterval 15
  ServerAliveCountMax 3
  ProxyCommand sh -c 'ip=$(/path/to/ssh-link-failover/bin/link-endpoint) || exit 1; exec nc "$ip" %p'

# 排查某条链路时用固定别名
Host myhost-direct
  HostName 192.168.10.2
  User me
Host myhost-lan
  HostName 10.0.0.5
  User me
Host myhost-ts
  HostName 100.64.0.10
  User me
