#!/bin/bash
# link-endpoint：按优先级返回第一个 TCP 端口可达的候选 IP。
#
#   link-endpoint          打印最优 IP；全部不可达时退出码 1、不输出
#   link-endpoint --list   只打印候选名单（"IP 标签"，已应用 IP 缓存），不探测
#
# 设计要点：
# - 用 nc -z 测端口而不是 ping：对端防火墙可能放行 sshd 却禁 ICMP，ping 通不等于能连。
# - macOS 的 nc 用 -G 指定连接超时，-w 是空闲超时，两个都给。
# - 不测延迟、不记历史，结果只由"当前哪条通"决定，便于推理和排查。
# - LINK_ENDPOINT_DEBUG=1 时把每跳结果打印到 stderr。

set -uo pipefail

CONFIG="${SSH_LINK_FAILOVER_CONFIG:-$HOME/.config/ssh-link-failover/config.sh}"
CACHE_DIR="${SSH_LINK_FAILOVER_STATE:-$HOME/.cache/ssh-link-failover}"
[ -r "$CONFIG" ] || { echo "link-endpoint: 找不到配置 $CONFIG" >&2; exit 2; }
# shellcheck source=/dev/null
source "$CONFIG"
PORT="${PORT:-22}"
PROBE_TIMEOUT="${PROBE_TIMEOUT:-2}"

debug() { [ "${LINK_ENDPOINT_DEBUG:-0}" = "1" ] && printf '[endpoint] %s\n' "$*" >&2; return 0; }

# 输出候选名单；若某标签有缓存 IP（由 link-manager 写入），用缓存替换配置里的值
list_candidates() {
  local entry ip label cached
  for entry in "${CANDIDATES[@]}"; do
    read -r ip label <<<"$entry"
    if [ -r "$CACHE_DIR/ip_$label" ]; then
      cached="$(head -n1 "$CACHE_DIR/ip_$label" | tr -d '[:space:]')"
      [[ "$cached" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] && ip="$cached"
    fi
    printf '%s %s\n' "$ip" "$label"
  done
}

if [ "${1:-}" = "--list" ]; then
  list_candidates
  exit 0
fi

while read -r ip label; do
  debug "probe $label $ip:$PORT timeout=${PROBE_TIMEOUT}s"
  if nc -z -G "$PROBE_TIMEOUT" -w "$PROBE_TIMEOUT" "$ip" "$PORT" >/dev/null 2>&1; then
    debug "hit $label -> $ip"
    printf '%s\n' "$ip"
    exit 0
  fi
  debug "miss $label"
done < <(list_candidates)

debug "no candidate reachable"
exit 1
